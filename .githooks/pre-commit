#!/bin/sh
# Enable with: git config core.hooksPath .githooks
# Rejects capture files with unmarked template-sized payloads
# (see tests/fixtures/captures/README.md).
set -eu

if git diff --cached --name-only --diff-filter=ACMR | grep -q '^tests/fixtures/captures/.*\.json$'; then
    cargo test --quiet -p zkteco-proto --test captures
fi
